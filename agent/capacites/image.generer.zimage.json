  "classe": "gpu",
  "famille": "zimage",
  "estimation": "durations.json"
 },
 "consentement": "rendu",
 "licence": {
  "nom": "Apache-2.0",
  "lue": true,
  "commercial": "oui",
  "source": "docs/etudes/image.md"
 },
 "sources": [
  "docs/etudes/image.md",
  "server/tools/image.py (MODELS)"
 ],
