{
  // La porte d'entrée de Showrunner Tools : le portail, sous https://showrunner.luxigone.workers.dev
  // (le nom du Worker + le sous-domaine workers.dev de Cal, celui de movie-analysis-partage).
  // SQUELETTE NON DÉPLOYÉ. Étude : docs/etudes/cloudflare.md ; le plan par étapes y dit quand remplir quoi.
  //
  // Quand Cal le décidera (étape 1 du plan), dans un terminal, depuis porte/ :
  //   npx wrangler login
  //   npx wrangler deploy --dry-run          (vérifie la configuration, dont "directory": "..")
  //   npx wrangler secret put PORTE_CLE      (la clé HMAC, la même que ~/.config/showrunner/porte.key sur les DGX)
  //   npx wrangler secret put ADMINS         (les e-mails admin, séparés par des virgules : pas dans ce dépôt public)
  //   npx wrangler deploy
  // Puis, dans Zero Trust, l'application Access self-hosted sur showrunner.luxigone.workers.dev (étude, § 2).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showrunner",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",

  "workers_dev": true,
  // Les « version URLs » (<version>-showrunner.luxigone.workers.dev) ne sont pas couvertes par une application Access
  // posée sur le nom d'hôte : on les coupe (https://developers.cloudflare.com/workers/configuration/previews/).
  // Le Worker refuserait de toute façon une requête sans jeton valide pour l'AUD ci-dessous.
  "preview_urls": false,

  // Les pages du portail sont le dépôt lui-même (chemins relatifs, window.SR_API inutile : même origine).
  // ../.assetsignore écarte server/, tools/, docs/, porte/, .git… Les requêtes d'assets sont gratuites et ne passent
  // pas par le Worker ; Access les garde quand même (application sur le nom d'hôte).
  // Limites : 20 000 fichiers (Workers Free), 25 Mio par fichier.
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/library/*", "/pont/*", "/agents/*"]
  },

  // Rien de secret ici, mais propre au compte de Cal : à remplir à l'étape 1.
  //   TEAM_DOMAIN : https://<nom d'équipe>.cloudflareaccess.com (Zero Trust → Settings)
  //   POLICY_AUD  : le tag AUD de l'application Access (Access → Applications → l'application → Overview)
  "vars": {
    "TEAM_DOMAIN": "https://<equipe>.cloudflareaccess.com",
    "POLICY_AUD": "<tag AUD de l'application Access>"
  },

  // La bibliothèque publiée (étape 3) : npx wrangler r2 bucket create showrunner-bibliotheque
  // Bucket privé : pas de r2.dev (non prévu pour la production, et Access ne peut pas le garder).
  "r2_buckets": [
    { "binding": "BIBLIO", "bucket_name": "showrunner-bibliotheque" }
  ],

  // Les DGX, par Workers VPC (bêta, gratuite pendant la bêta), un tunnel sortant par machine, sans nom d'hôte public.
  // Chaque service vise UNE adresse et UN port, sur 127.0.0.1 de la machine du tunnel : jamais une « VPC Network »,
  // qui laisserait le Worker joindre tout ce que voit le tunnel (ComfyUI, Ollama… ouverts sur le réseau local).
  //   PORTAIL   → tunnel de DGX2, 127.0.0.1:9790 (la porte du portail : 8790 + 1000, signature exigée)   étape 2
  //   PONT_DGX2 → tunnel de DGX2, 127.0.0.1:9770 (la porte du pont de DGX2)                              étape 4
  //   PONT_DGX1 → tunnel de DGX1, 127.0.0.1:9770 (la porte du pont de DGX1)                              étape 4
  // Création (tableau de bord Workers VPC → VPC Services, ou npx wrangler vpc service create … --type http
  //   --tunnel-id <id> --ipv4 127.0.0.1 --http-port 9790), puis coller l'identifiant rendu.
  "vpc_services": [
    { "binding": "PORTAIL", "service_id": "<id du service portail-dgx2>" },
    { "binding": "PONT_DGX2", "service_id": "<id du service pont-dgx2>" },
    { "binding": "PONT_DGX1", "service_id": "<id du service pont-dgx1>" }
  ],

  // Limite de débit par e-mail sur ce qui écrit : 30 par minute, compté par lieu Cloudflare (pas global).
  // namespace_id : un nombre choisi, unique dans le compte. La disponibilité sur Workers Free n'est pas précisée par
  // la documentation : si le déploiement la refuse, retirer ce bloc (le Worker s'en passe).
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "8790", "simple": { "limit": 30, "period": 60 } }
  ],

  // Plus tard (étude, § 6) : l'agent de l'étage Identité, un Durable Object par personnage.
  // "durable_objects": { "bindings": [{ "name": "IDENTITE", "class_name": "Identite" }] },
  // "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Identite"] }],

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
