{
  "_source": "Traduit au format API depuis le gabarit officiel ComfyUI « audio_ace_step1_5_xl_base.json » (paquet comfyui_workflow_templates_json 0.1.95, installé dans ~/comfyui-env de DGX2). Réglages repris tels quels : ModelSamplingAuraFlow shift 3, KSampler 50 pas, cfg 6, euler/simple, négatif = ConditioningZeroOut du positif ; encodeur cfg_scale 2, temperature 0.85, top_p 0.9, generate_audio_codes vrai. Seule la sortie change : SaveAudioAdvanced en FLAC (sans perte) au lieu du MP3 V0 du gabarit.",
  "104": {"class_type": "UNETLoader", "_meta": {"title": "ACE-Step 1.5 XL base"},
          "inputs": {"unet_name": "acestep_v1.5_xl_base_bf16.safetensors", "weight_dtype": "default"}},
  "105": {"class_type": "DualCLIPLoader", "_meta": {"title": "encodeurs Qwen ACE 1.5"},
          "inputs": {"clip_name1": "qwen_0.6b_ace15.safetensors", "clip_name2": "qwen_4b_ace15.safetensors",
                     "type": "ace", "device": "default"}},
  "106": {"class_type": "VAELoader", "_meta": {"title": "VAE ACE 1.5"},
          "inputs": {"vae_name": "ace_1.5_vae.safetensors"}},
  "78": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "shift"},
         "inputs": {"model": ["104", 0], "shift": 3}},
  "94": {"class_type": "TextEncodeAceStepAudio1.5", "_meta": {"title": "style et paroles"},
         "inputs": {"clip": ["105", 0], "tags": "{{tags}}", "lyrics": "{{lyrics}}", "seed": "{{seed}}",
                    "bpm": "{{bpm}}", "duration": "{{duration}}", "timesignature": "{{timesignature}}",
                    "language": "{{language}}", "keyscale": "{{keyscale}}", "generate_audio_codes": true,
                    "cfg_scale": 2.0, "temperature": 0.85, "top_p": 0.9, "top_k": 0, "min_p": 0.0}},
  "98": {"class_type": "EmptyAceStep1.5LatentAudio", "_meta": {"title": "durée"},
         "inputs": {"seconds": "{{duration}}", "batch_size": 1}},
  "47": {"class_type": "ConditioningZeroOut", "_meta": {"title": "négatif nul"},
         "inputs": {"conditioning": ["94", 0]}},
  "3": {"class_type": "KSampler", "_meta": {"title": "échantillonneur"},
        "inputs": {"model": ["78", 0], "positive": ["94", 0], "negative": ["47", 0], "latent_image": ["98", 0],
                   "seed": "{{seed}}", "steps": 50, "cfg": 6.0, "sampler_name": "euler", "scheduler": "simple",
                   "denoise": 1.0}},
  "18": {"class_type": "VAEDecodeAudio", "_meta": {"title": "décodage"},
         "inputs": {"samples": ["3", 0], "vae": ["106", 0]}},
  "111": {"class_type": "SaveAudioAdvanced", "_meta": {"title": "OUT"},
          "inputs": {"audio": ["18", 0], "filename_prefix": "showrunner/musique", "format": "flac"}}
}
