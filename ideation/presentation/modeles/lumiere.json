  "slideBg": { "title": "bg", "section": "bg", "image": "bg", "quote": "bg", "numbers": "bg", "grid": "bg", "content": "bg", "end": "bg" },
  "decor": [
    { "kind": "glow", "on": ["title", "end", "section"], "x": 1500, "y": 260, "r": 760, "opacity": 0.5, "tone": "accent", "layer": "back",
