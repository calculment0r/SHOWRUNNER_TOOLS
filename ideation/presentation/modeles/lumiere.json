{
  "id": "lumiere",
  "name": "Lumière",
  "kind": "motion",
  "direction": "keynote produit, lumineux",
  "line": "Noir d’écran, halos qui flottent, titres qui montent mot à mot sur un ressort, chiffres qui roulent, une image qui grandit d’une diapositive à l’autre.",
  "brand": "Showrunner 2",
  "palette": { "bg": "#06070b", "surface": "#10131c", "ink": "#f5f7ff", "muted": "#9aa3b8", "accent": "#8c9aff", "accent2": "#3fe0c5", "inverse": "#06070b", "line": "#f5f7ff", "veil": "#06070b" },
  "styles": {
    "display": { "font": "intertight", "size": 180, "weight": 600, "lh": 0.95, "track": -0.045, "upper": false },
